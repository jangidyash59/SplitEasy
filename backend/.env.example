# SplitEasy Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/spliteasy?retryWrites=true&w=majority

# JWT secret key for authentication
JWT_SECRET=your_jwt_secret_key_here

# Upstash Redis for distributed locks and caching
UPSTASH_REDIS_REST_URL=https://<your-upstash-redis>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your_upstash_token>

# Google Gemini API key for receipt and payment screenshot OCR
GEMINI_API_KEY=<your_gemini_api_key>

# Frontend client URL (Vercel deployment URL)
CLIENT_URL=https://your-spliteasy-frontend.vercel.app
