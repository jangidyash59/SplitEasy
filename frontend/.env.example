# SplitEasy Frontend Environment Variables (Vercel)
# Set these in your Vercel project settings under Environment Variables

# Backend URL (deployed on Render)
VITE_API_URL=https://your-spliteasy-backend.onrender.com

# Socket.IO URL (same as Render backend URL)
VITE_SOCKET_URL=https://your-spliteasy-backend.onrender.com
